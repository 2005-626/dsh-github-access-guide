{
  "name": "dsh-github-access-guide",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "description": "Sidebar panel that repairs GitHub access on restricted networks: a local racing proxy that takes over the Windows system proxy (reversibly), a verified git accelerator rewrite, live channel status, and a URL converter.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "proxy",
    "network"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2005-626/dsh-github-access-guide.git"
  },
  "homepage": "https://github.com/2005-626/dsh-github-access-guide#readme",
  "bugs": {
    "url": "https://github.com/2005-626/dsh-github-access-guide/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "proxy.js",
    "system-proxy.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
